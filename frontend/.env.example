# ---------------------------------------------------------------------------
# Dashboard configuration
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and it
# INLINES them at build time — so these are build-image settings, not runtime
# ones. A build pointed at localhost cannot be re-pointed at Azure by changing
# an env var on the container; rebuild instead. That is the trade for shipping
# the dashboard as plain static files with no server of its own.
#
# Copy to `.env.local` for local dev:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. No trailing slash (one is stripped anyway).
VITE_API_BASE_URL=http://localhost:8000

# Shown verbatim in the "API unreachable" error panel so the operator can copy
# the command that starts the backend. Override it if the repo layout changes.
VITE_BACKEND_START_COMMAND=./.venv/bin/uvicorn backend.main:app --reload --port 8000
