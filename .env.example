# ---------------------------------------------------------------------------
# Fleet Telemetry Data Platform — configuration
#
# Every component (generator, Prefect flows, DuckDB warehouse, FastAPI backend)
# reads its storage config from these variables ONLY. There are no hardcoded
# paths anywhere in the codebase, which is what makes the same image runnable
# locally and as an Azure Container Apps Job.
#
# Copy to `.env` for local dev:  cp .env.example .env
# ---------------------------------------------------------------------------

# Which lake backend to write to: "local" (filesystem) or "azure" (Blob Storage)
LAKE_BACKEND=local

# --- local backend ---------------------------------------------------------
# Root directory of the local lakehouse. Relative paths resolve from repo root.
LAKE_LOCAL_ROOT=./data

# --- azure backend ---------------------------------------------------------
# Set these only when LAKE_BACKEND=azure. In Azure these are injected as
# Container Apps *secrets*, never as plaintext env vars in the manifest.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=fleet-lake

# --- layer prefixes (rarely changed) ---------------------------------------
BRONZE_PREFIX=raw
SILVER_PREFIX=silver
GOLD_PREFIX=gold

# --- generator defaults ----------------------------------------------------
FLEET_SIZE=500
GENERATOR_SEED=42
